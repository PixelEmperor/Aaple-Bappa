# The site's own public origin, e.g. https://aaplebappa.in — used to reject
# cross-site mutations at the tRPC endpoint (src/server/same-origin.ts).
# On Vercel, preview deploys fall back to VERCEL_URL and production to
# VERCEL_PROJECT_PRODUCTION_URL, both set by the platform; this var is what
# covers a custom domain fronted by Cloudflare, where the browser's Origin
# is neither of those. Leave unset locally — localhost:3000 is allowed when
# VERCEL is absent.
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API. Postgres + Auth only: photo storage
# has moved to Cloudflare R2 below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — mandal-photos bucket. R2 dashboard > Manage API tokens for
# the access key pair; CLOUDFLARE_R2_PUBLIC_URL is the bucket's public base
# (its r2.dev subdomain, or a custom domain you've mapped to it) and must
# also be added to next.config.ts's image remotePatterns if it changes.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# PostHog — Project Settings > Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry — DSNs aren't secret (Sentry's own model), but the client SDK needs
# the NEXT_PUBLIC_ prefix to read it at all. ORG/PROJECT/AUTH_TOKEN are only
# used for source-map upload at build time (next.config.ts) — leave unset to
# skip that step entirely.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
