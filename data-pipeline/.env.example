# Same project as apps/web/.env.local — Project Settings > API.
SUPABASE_URL=
# Service-role key: bypasses RLS. Keep this out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# Same Cloudflare R2 account/bucket as apps/web/.env.local — only needed if
# import_to_supabase.py is run with photos present in --photos-dir. Photo
# storage moved off Supabase Storage onto R2; next.config.ts's image
# remotePatterns only allows the R2 host, so a photo uploaded anywhere else
# wouldn't render through next/image regardless of the URL this script wrote.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
